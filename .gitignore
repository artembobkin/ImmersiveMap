.DS_Store
# Personal, machine specific agent permissions. The shared project rules live in
# the tracked .claude/settings.json next to it.
.claude/settings.local.json
# playwright-mcp browser-automation artifacts (console logs, screenshots)
/.playwright-mcp/
/.build/
/.swiftpm/
/.worktrees/
/DerivedData/
/Traces/
# xcodebuild test result bundles (CI uploads them as artifacts on failure)
*.xcresult
# Visual review renders: large, machine specific, regenerated on demand.
# The verdicts next to them (Tools/VisualReview/verdicts.json) are committed.
/Tools/VisualReview/Output/
# Reports a reviewer hands back: the renders again, plus a copy of the
# judgements that the verdict file already carries.
/Tools/VisualReview/Reports/
/ImmersiveMapMacDevelop/
/ImmersiveMapIOSDevelop/
/ImmersiveMap.local.xcworkspace/
/Docs/
/docs/
DerivedData/
**/xcuserdata/
*.xcuserstate
*.xccheckout
*.moved-aside
*.ipa
*.dSYM.zip
*.dSYM

# A developer's own tile API key, read by the demo apps. Never committed.
/LocalSecrets.plist
