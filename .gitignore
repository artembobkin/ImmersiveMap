.DS_Store
# Claude Code setup: CLAUDE.md, the path-scoped rules and the shared settings
# are committed. A person's own permissions and the worktrees stay local.
/.claude/settings.local.json
/.claude/worktrees/
# playwright-mcp browser-automation artifacts (console logs, screenshots)
/.playwright-mcp/
/.build/
# The model tile baker is a package of its own with its own build folder.
/.swiftpm/
/.worktrees/
/DerivedData/
/Traces/
# xcodebuild test result bundles (CI uploads them as artifacts on failure)
*.xcresult
/ImmersiveMapMacDevelop/
/ImmersiveMapIOSDevelop/
/ImmersiveMap.local.xcworkspace/
/Docs/
/docs/
DerivedData/
**/xcuserdata/
*.xcuserstate
*.xccheckout
*.moved-aside
*.ipa
*.dSYM.zip
*.dSYM

# A developer's own tile API key, read by the demo apps. Never committed.
/LocalSecrets.plist

